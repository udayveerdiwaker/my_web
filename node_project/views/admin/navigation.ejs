<%- include('admin_header') %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0">Navigation Management</h1>
  <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addLinkModal">
    <i class="bi bi-plus-circle me-2"></i> Add New Link
  </button>
</div>

<!-- Table Card -->
<div class="card table-card shadow-sm border-0 mb-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr class="table-light">
          <th width="10%" class="ps-4">ID</th>
          <th width="25%">Link Text</th>
          <th width="35%">URL / Href</th>
          <th width="15%">Status</th>
          <th width="15%" class="text-end pe-4">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (navigation && navigation.length > 0) { %>
          <% navigation.forEach(function(item) { %>
            <tr>
              <td class="ps-4"><%= item.id %></td>
              <td class="fw-semibold"><%= item.navbar_links %></td>
              <td>
                <span class="text-muted"><%= item.href %></span>
              </td>
              <td>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Active</span>
              </td>
              <td class="text-end pe-4">
                <div class="d-inline-flex gap-2">
                  <button type="button" class="btn btn-sm btn-outline-primary" 
                          onclick="openEditModal('<%= item.id %>', '<%= item.navbar_links %>', '<%= item.href %>')">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                  </button>
                  <a href="/admin/navigation/delete/<%= item.id %>" class="btn btn-sm btn-outline-danger" 
                     onclick="return confirm('Are you sure you want to delete this navigation link?')">
                    <i class="bi bi-trash me-1"></i> Delete
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-5 text-muted">No navigation links found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Add Link Modal -->
<div class="modal fade" id="addLinkModal" tabindex="-1" aria-labelledby="addLinkModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="addLinkModalLabel">Add Navigation Link</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/navigation/add" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="navbar_links" class="form-label">Link Text</label>
            <input type="text" class="form-control" id="navbar_links" name="navbar_links" placeholder="e.g., About, Contact" required>
            <div class="form-text">The text that will appear in the navigation bar.</div>
          </div>
          <div class="mb-3">
            <label for="href" class="form-label">URL / Path</label>
            <input type="text" class="form-control" id="href" name="href" placeholder="e.g., about.php?about=About" required>
            <div class="form-text">The relative destination URL page path.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Save Link</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Link Modal -->
<div class="modal fade" id="editLinkModal" tabindex="-1" aria-labelledby="editLinkModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title" id="editLinkModalLabel">Update Navigation Link</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editLinkForm" action="/admin/navigation/edit" method="POST">
        <input type="hidden" id="edit_id" name="id">
        <div class="modal-body">
          <div class="mb-3">
            <label for="edit_navbar_links" class="form-label">Link Text</label>
            <input type="text" class="form-control" id="edit_navbar_links" name="navbar_links" required>
            <div class="form-text">The text that will appear in the navigation bar.</div>
          </div>
          <div class="mb-3">
            <label for="edit_href" class="form-label">URL / Path</label>
            <input type="text" class="form-control" id="edit_href" name="href" required>
            <div class="form-text">The relative destination URL page path.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Update Link</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openEditModal(id, text, href) {
    document.getElementById('edit_id').value = id;
    document.getElementById('edit_navbar_links').value = text;
    document.getElementById('edit_href').value = href;
    
    // Open the modal
    const editModal = new bootstrap.Modal(document.getElementById('editLinkModal'));
    editModal.show();
  }
</script>

<%- include('admin_footer') %>
